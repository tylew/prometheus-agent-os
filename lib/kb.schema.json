{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometheus/kb.schema.json",
  "title": "prometheus knowledge base",
  "description": "Frontmatter per note type (person, person-part, org, concept, system, topic, decision), the edge vocabulary, and the ingest-proposal shape with a basis per fact. Notes live under docs/kb/; kb.py is the only writer.",
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "links": {"type": "array", "items": {"type": "string", "pattern": "^\\[\\[[^\\]]+\\]\\]$"}},
    "edges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member_of": {"$ref": "#/$defs/links"}, "owns": {"$ref": "#/$defs/links"},
        "works_with": {"$ref": "#/$defs/links"}, "part_of": {"$ref": "#/$defs/links"},
        "depends_on": {"$ref": "#/$defs/links"}, "evidence": {"$ref": "#/$defs/links"},
        "decided_by": {"$ref": "#/$defs/links"}, "supersedes": {"$ref": "#/$defs/links"},
        "relates_to": {"$ref": "#/$defs/links"}
      }
    },
    "common": {
      "type": "object",
      "required": ["title", "type", "scope", "status", "refs", "created", "updated"],
      "properties": {
        "title": {"type": "string"},
        "type": {"enum": ["person", "org", "concept", "system", "topic", "decision"]},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"enum": ["active", "superseded"]},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "refs": {"type": "array", "items": {"type": "string"}},
        "edges": {"$ref": "#/$defs/edges"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "created": {"$ref": "#/$defs/date"},
        "updated": {"$ref": "#/$defs/date"},
        "part": {"const": "overview"},
        "role": {"type": "string"}, "team": {"type": "string"}, "reports_to": {"type": "string"},
        "location": {"type": "string"},
        "handles": {"type": "object", "additionalProperties": {"type": "string"}},
        "kind": {"type": "string"},
        "repo": {"type": "string"}, "paths": {"type": "array", "items": {"type": "string"}},
        "decided": {"$ref": "#/$defs/date"},
        "binds_to": {"type": "array", "items": {"type": "string"}},
        "migrated_from": {"type": "string"}
      },
      "additionalProperties": false
    },
    "person_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "type", "part", "person", "refs", "created", "updated"],
      "properties": {
        "title": {"type": "string"}, "type": {"const": "person-part"}, "part": {"type": "string"},
        "person": {"type": "string", "pattern": "^\\[\\[[^\\]]+\\]\\]$"},
        "refs": {"type": "array", "items": {"type": "string"}},
        "created": {"$ref": "#/$defs/date"}, "updated": {"$ref": "#/$defs/date"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "text": {"type": "string"}, "field": {"type": "string"}, "value": {"type": "string"},
        "interaction": {"type": "string"},
        "basis": {"enum": ["decided", "merged", "stated", "confirmed", "tentative"]},
        "quote": {"type": "string"}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "$comment": {"type": "string"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "date"],
          "properties": {
            "kind": {"enum": ["meeting", "pr", "story", "operator", "doc", "migration"]},
            "ref": {"type": "string"}, "date": {"$ref": "#/$defs/date"}
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mention", "type", "facts"],
            "properties": {
              "mention": {"type": "string"},
              "type": {"enum": ["person", "org", "concept", "system", "topic"]},
              "scope": {"type": "array", "items": {"type": "string"}},
              "aliases": {"type": "array", "items": {"type": "string"}},
              "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "decision", "why", "basis", "signoff", "binds_to", "scope"],
            "properties": {
              "title": {"type": "string"}, "decision": {"type": "string"}, "context": {"type": "string"},
              "why": {"type": "string"}, "basis": {"enum": ["decided", "confirmed"]},
              "signoff": {"type": "string"}, "quote": {"type": "string"},
              "binds_to": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(sc-\\d+|operator)$"}},
              "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "evidence": {"type": "array", "items": {"type": "string"}},
              "decided_by": {"type": "array", "items": {"type": "string"}},
              "supersedes": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "edge", "to"],
            "properties": {
              "from": {"type": "string"},
              "edge": {"enum": ["member_of", "owns", "works_with", "part_of", "depends_on", "evidence",
                                "decided_by", "supersedes", "relates_to"]},
              "to": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
