{
  "$comment": "Tier-2 allow-list probes, run by lib/probes.py against each role's merged settings (lib/launch.sh). Per role: `allow` must be permitted, `deny` must be refused, `ask` must prompt per call. A string is a Bash command, unless it names a tool: `mcp__<server>__<tool>`, or `Read|Write|Edit|Glob|Grep|Agent|Skill|Workflow|AskUserQuestion[(<path or arg>)]`. An object {cmd, live, why} carries the form --live executes instead (live: false = static only; a Bash allow probe without `live` runs verbatim, so it must be safe to execute). A Bash deny probe runs live only when it carries `live`. Placeholders: {workspace}, {state_dir}, {plugin_root}, {wt} (a worktree path that does not exist, so live forms fail harmlessly).",
  "roles": {
    "seat": {
      "allow": [
        "{workspace}/.claude/prometheus/projects/besstie/scratch-test.sh {wt}",
        {
          "cmd": "send.sh --role pm \"status?\"",
          "live": "send.sh --help"
        },
        {
          "cmd": "report.sh waiting on operator",
          "live": "report.sh --help"
        },
        "mcp__shortcut__stories-get-by-id"
      ],
      "deny": [
        "mcp__shortcut__stories-update",
        "mcp__shortcut__stories-create",
        "mcp__shortcut__stories-create-comment",
        "mcp__launchdarkly__update-feature-flag"
      ]
    },
    "pm": {
      "allow": [
