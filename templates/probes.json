          "live": "{plugin_root}/skills/dispatch/scripts/send.sh --help"
        },
        "python3 \"{plugin_root}/lib/registry.py\" field repo.slug --key besstie",
        "python3 {plugin_root}/lib/registry.py field repo.slug --key besstie",
        "make -C {wt}/voltuspy/brightfield-besstie lint VOLTUS={wt}",
        "make -C {wt}/voltuspy/brightfield-besstie run_test VOLTUS={wt}",
        "git -C {wt} status --short",
        "git status",
        {
          "cmd": "gt create -m \"Add thing\"",
