          "live": false
        },
        "Write({wt}/voltuspy/brightfield-besstie/x.py)",
        "Edit({wt}/voltuspy/brightfield-besstie/x.py)",
        "Read({workspace}/CLAUDE.md)",
        "mcp__shortcut__stories-get-by-id",
        "git -C {wt} status --short && ls {state_dir}",
        "gh api repos/o/r/issues/1/comments --paginate --jq .",
        "Write({state_dir}/reviews/x.md)"
