          "cmd": "send.sh --role implementor \"go\"",
          "live": "send.sh --help"
        },
        {
          "cmd": "report.sh unit on track",
          "live": "report.sh --help"
        },
        {
          "cmd": "unit-tokens.sh --stage review --add-pr o/r#1",
          "live": "unit-tokens.sh --help"
        },
        "python3 \"{plugin_root}/lib/registry.py\" field repo.slug --key besstie",
        "mcp__shortcut__stories-update",
        "mcp__launchdarkly__get-feature-flag",
        {
          "cmd": "composio search sheets",
          "live": false
        },
        "gh api repos/o/r/issues/1/comments --paginate --jq .",
        "Write({state_dir}/reviews/x.md)"
      ],
      "ask": [
        "mcp__launchdarkly__update-feature-flag",
        {
          "cmd": "composio execute GOOGLESHEETS_GET x",
          "live": false
        }
      ],
      "deny": [
        {
          "cmd": "composio link googlesheets",
          "live": false
        },
        "gh api repos/o/r/issues/1/comments -f body=x",
        "gh api repos/o/r/issues/1/comments -X POST",
        "gh api repos/o/r/issues/1/comments --input body.json"
      ]
    },
    "planner": {
      "allow": [
        "{workspace}/.claude/prometheus/projects/besstie/scratch-test.sh {wt}",
        {
          "cmd": "send.sh --role pm \"stories ready\"",
          "live": "send.sh --help"
        },
        "mcp__shortcut__stories-create"
