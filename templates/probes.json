        "git commit -m x",
        "git push origin HEAD",
        "gt submit",
        "gh pr merge 1",
        "AskUserQuestion",
        "Write({wt}/voltuspy/brightfield-besstie/x.py)",
        "Edit({workspace}/docs/x.md)",
        "mcp__shortcut__stories-update",
        "mcp__shortcut__stories-create",
        "mcp__shortcut__stories-create-comment",
