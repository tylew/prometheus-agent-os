{
  "$comment": "Depth-3 implementor: never prompts a human. Launched with --permission-mode dontAsk --settings <this file>; anything not allowed is denied and reported to the PM. open-tab.sh appends the project's registry validation commands to allow.",
  "extends": [
    "delivery"
  ],
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Edit",
      "Write",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git -C * add *)",
      "Bash(gt add *)",
      "Bash(gt continue)",
      "Bash(gt continue *)",
      "Bash(gt branch info)",
      "Bash(gt branch info *)",
      "Bash(git restore *)",
      "Bash(gt create *)",
      "Bash(gt modify *)",
      "Bash(gt restack *)",
      "Bash(gt sync *)",
      "Bash(gt log *)",
      "Bash(gt submit --draft *)",
      "Bash(python3 */lib/registry.py *)",
      "Bash(send.sh *)",
      "Bash(report.sh *)",
      "Bash(python3 \"*/lib/registry.py\" *)",
      "Bash(*/.claude/prometheus/projects/*/*.sh *)"
    ],
    "deny": [
      "AskUserQuestion",
      "Bash(gt submit --publish *)",
      "Bash(gt submit * --publish*)",
      "Bash(gt submit * -a*)",
      "Bash(gt submit * -b*)",
      "Bash(gt submit * -c*)",
      "Bash(gt submit * -d*)",
      "Bash(gt submit * -e*)",
