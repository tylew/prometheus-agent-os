{
  "$comment": "Shared base for the delivery roles (pm, implementor, reviewer): a role file opts in with \"extends\": [\"delivery\"] and lib/launch.sh merges launch.json → this → the role (lists add up). Holds the reads all three need ({workspace} is an additional directory so cat / grep / ls reach plugin skills, docs and node_modules — the Read tool already does), the review artifact write under {state_dir}/reviews/, and the PR conversation read (gh api …/issues/*/comments, …/pulls/comments/<id>) — read-only: every write form on those paths is denied, a write flag matched bare-prefixed (-X*, --input*) so its attached form (-XPOST, --method=PATCH) is denied too. FE validation runs in the npm --prefix <worktree>/js form (no cd); test only with CI=true (optionally under timeout), snapshot writes (-u / --updateSnapshot) denied. A deny whose pattern has an inner * is listed bare and with ' *' (live, the trailing ' *' does not match the bare command). A rule lives here or in a role file, never both.",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(*/skills/dispatch/scripts/send.sh *)",
      "Bash(*/skills/dispatch/scripts/report.sh *)",
      "Bash(git -C * show *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log *)",
      "Bash(git -C * ls-tree *)",
      "Bash(git -C * rev-parse *)",
      "Bash(git -C * fetch *)",
      "Bash(git -C * status *)",
      "Bash(git -C * cat-file *)",
      "Bash(git ls-tree *)",
      "Bash(git cat-file *)",
      "Bash(git grep *)",
      "Bash(git -C * grep *)",
      "Bash(make -C * lint *)",
      "Bash(make -C * run_test *)",
      "Edit(/{state_dir}/reviews/**)",
      "Bash(gh api repos/*/issues/*/comments)",
      "Bash(gh api repos/*/issues/*/comments *)",
      "Bash(npm --prefix * run jslint *)",
      "Bash(npm --prefix * run check:types *)",
      "Bash(CI=true npm --prefix * run test *)",
      "Bash(git merge-base *)",
      "Bash(git -C * merge-base *)",
      "Bash(git range-diff *)",
      "Bash(git -C * range-diff *)",
      "Bash(git ls-files *)",
      "Bash(git -C * ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git -C * ls-remote *)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(git -C * worktree list)",
      "Bash(git -C * worktree list *)",
      "Bash(gh api repos/*/pulls/comments/*)",
      "Bash(gh api repos/*/pulls/comments/* *)",
      "Bash(CI=true timeout * npm --prefix * run test *)"
    ],
    "deny": [
      "Bash(gh api repos/*/issues/* -f*)",
      "Bash(gh api repos/*/issues/* -F*)",
      "Bash(gh api repos/*/issues/* --field*)",
      "Bash(gh api repos/*/issues/* --raw-field*)",
      "Bash(gh api repos/*/issues/* -X*)",
      "Bash(gh api repos/*/issues/* --method*)",
      "Bash(gh api repos/*/issues/* --input*)",
      "Bash(*npm --prefix * run test * -u*)",
      "Bash(*npm --prefix * run test *--updateSnapshot*)",
      "Bash(gh api repos/*/pulls/comments/* -X*)",
      "Bash(gh api repos/*/pulls/comments/* --method*)",
      "Bash(gh api repos/*/pulls/comments/* -f*)",
      "Bash(gh api repos/*/pulls/comments/* -F*)",
      "Bash(gh api repos/*/pulls/comments/* --field*)",
      "Bash(gh api repos/*/pulls/comments/* --raw-field*)",
      "Bash(gh api repos/*/pulls/comments/* --input*)"
    ],
    "additionalDirectories": [
      "{workspace}"
    ]
  }
}
