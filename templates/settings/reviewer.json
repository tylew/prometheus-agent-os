{
  "$comment": "Depth-3 reviewer: never prompts a human, never edits code. Launched with --permission-mode dontAsk; anything not allowed is denied and reported to the PM. Writes only its findings file under {state_dir}/reviews/ (launch.sh fills in the real state dir). open-tab.sh appends the project's validation commands.",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git fetch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git worktree add --detach *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh api repos/*/pulls/*/comments *)",
      "Bash(gh api repos/*/pulls/*/reviews *)",
      "Bash(semgrep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(*/skills/dispatch/scripts/send.sh *)",
      "Bash(python3 */lib/registry.py *)",
      "Write({state_dir}/reviews/**)",
      "Bash(git -C * show *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log *)",
      "Bash(git -C * ls-tree *)",
      "Bash(git -C * rev-parse *)",
      "Bash(git -C * fetch *)",
      "Bash(git -C * status *)",
      "Bash(git -C * cat-file *)",
      "Bash(git ls-tree *)",
      "Bash(git cat-file *)",
      "Bash(git rev-parse *)",
      "Bash(git grep *)",
      "Bash(git -C * grep *)"
    ],
    "deny": [
      "AskUserQuestion",
      "Edit",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gt *)",
      "Bash(gh pr merge *)",
      "mcp__shortcut__stories-update",
      "mcp__shortcut__stories-create"
    ]
  }
}
