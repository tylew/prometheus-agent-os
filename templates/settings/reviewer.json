{
  "$comment": "Depth-3 reviewer: never prompts a human, never edits code. Launched with --permission-mode dontAsk; anything not allowed is denied and reported to the PM. Writes only its findings file under ~/.claude/prometheus/reviews/. open-tab.sh appends the project's validation commands.",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git fetch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git worktree add --detach *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh api repos/*/pulls/*/comments *)",
      "Bash(gh api repos/*/pulls/*/reviews *)",
      "Bash(semgrep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(*/skills/dispatch/scripts/send.sh *)",
      "Bash(python3 */lib/registry.py *)",
      "Write(~/.claude/prometheus/reviews/**)"
    ],
    "deny": [
      "AskUserQuestion",
      "Edit",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gt *)",
      "Bash(gh pr merge *)",
      "mcp__shortcut__stories-update",
      "mcp__shortcut__stories-create"
    ]
  }
}
