{
  "$comment": "The librarian, beside the seat: never prompts (dontAsk), writes the KB only through kb.py, proposals under {state_dir}/kb-proposals/, commits the workspace repo by pathspec.",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "Write(/{state_dir}/kb-proposals/**)",
      "Bash(python3 */lib/kb.py *)",
      "Bash(python3 */lib/registry.py *)",
      "Bash(*/skills/dispatch/scripts/send.sh *)",
      "Bash(*/skills/dispatch/scripts/report.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(ls *)",
      "mcp__shortcut__stories-get-by-id",
      "Bash(send.sh *)",
      "Bash(report.sh *)"
    ],
    "deny": [
      "AskUserQuestion",
      "Edit",
      "Bash(git add *)",
      "Bash(git push *)",
      "Bash(gt *)",
      "mcp__shortcut__stories-update",
      "mcp__shortcut__stories-create"
    ]
  }
}
