      "Bash(*/skills/agent-tabs/scripts/send-brief.sh *)",
      "Bash(python3 */lib/registry.py *)",
      "Bash(python3 \"*/lib/registry.py\" *)",
      "Bash(send.sh *)",
      "Bash(report.sh *)",
      "Bash(cp * {state_dir}/engine/stories/*)",
      "Bash(mkdir -p {state_dir}/engine/stories/*)",
      "Edit(/{state_dir}/engine/stories/**)",
      "mcp__shortcut__stories-get-by-id",
      "mcp__shortcut__stories-update",
