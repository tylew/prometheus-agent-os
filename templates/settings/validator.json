{
  "$comment": "Validator: ends one story \u2014 local dev, the Chrome walk, ONE AskUserQuestion in its own tab, the criteria ticks, the bottom-up merge, the closeout tab. Not dontAsk: its question (and any prompt its dev bring-up raises) is answered in its own tab and holds only it. Merges only with --squash --match-head-commit (never --admin); gt sync and gt submit --update-only restack the next rung during a merge. No code edits, no commits.",
  "extends": [
    "delivery"
  ],
  "permissions": {
    "allow": [
      "Agent",
      "Skill",
      "Bash(gh pr merge * --squash --match-head-commit *)",
      "Bash(gt sync *)",
      "Bash(gt sync)",
      "Bash(gt submit --update-only *)",
      "Bash(gt log *)",
      "Bash(git -C * switch *)",
      "Bash(git -C * checkout *)",
      "Bash(git -C * reflog *)",
      "Bash(python3 */lib/units.py open-tab *)",
